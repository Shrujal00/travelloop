# Copy this file to .env.local and fill in values from the Supabase dashboard:
# https://supabase.com/dashboard/project/_/settings/api
#
# Local dev: `cp .env.example .env.local` then paste your Project URL and anon (or publishable) key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Legacy anon key (Settings → API → Legacy API Keys) — valid through 2026.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: newer projects may use a publishable key instead of anon.
# If set, it is used when NEXT_PUBLIC_SUPABASE_ANON_KEY is omitted.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Phase D — optional Photon overrides (defaults: Komoot public API + Traveloop User-Agent)
# PHOTON_API_BASE_URL=https://photon.komoot.io/api/
# PHOTON_USER_AGENT=YourApp/1.0 (contact@example.com)

# Phase E — OpenStreetMap Overpass (defaults: overpass-api.de + Traveloop User-Agent)
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# OVERPASS_USER_AGENT=YourApp/1.0 (contact@example.com)
# WIKIPEDIA_USER_AGENT=YourApp/1.0 (contact@example.com)
