# Copy this file to .env.local and fill in values from the Supabase dashboard:
# https://supabase.com/dashboard/project/_/settings/api
#
# Local dev: `cp .env.example .env.local` then paste your Project URL and anon (or publishable) key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Legacy anon key (Settings → API → Legacy API Keys) — valid through 2026.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: newer projects may use a publishable key instead of anon.
# If set, it is used when NEXT_PUBLIC_SUPABASE_ANON_KEY is omitted.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
